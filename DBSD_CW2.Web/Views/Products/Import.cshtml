@{
    ViewData["Title"] = "Import Products";
}

<h1>Import Products</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Import from XML</h5>
            </div>
            <div class="card-body">
                <form asp-action="ImportFromXml" enctype="multipart/form-data" method="post">
                    <div class="form-group">
                        <label for="xmlFile">Select XML File</label>
                        <input type="file" class="form-control" id="xmlFile" name="file" accept=".xml" required />
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary">Import XML</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Import from JSON</h5>
            </div>
            <div class="card-body">
                <form asp-action="ImportFromJson" enctype="multipart/form-data" method="post">
                    <div class="form-group">
                        <label for="jsonFile">Select JSON File</label>
                        <input type="file" class="form-control" id="jsonFile" name="file" accept=".json" required />
                    </div>
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary">Import JSON</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Import Instructions</h5>
            </div>
            <div class="card-body">
                <h6>File Format Requirements:</h6>
                <ul>
                    <li>XML files should contain a list of product elements with the following fields:
                        <ul>
                            <li>Name (required)</li>
                            <li>Description</li>
                            <li>Price (required)</li>
                            <li>StockQuantity (required)</li>
                            <li>CategoryId (required)</li>
                        </ul>
                    </li>
                    <li>JSON files should contain an array of product objects with the same fields as above.</li>
                    <li>The system will automatically:
                        <ul>
                            <li>Generate new IDs for imported products</li>
                            <li>Set the creation and modification dates</li>
                            <li>Set the active status to true</li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div> 