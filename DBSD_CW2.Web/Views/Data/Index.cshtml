@model IEnumerable<DBSD_CW2.Data.Models.Product>

@{
    ViewData["Title"] = "Data Filtration, Paging, and Sorting";
}

<div class="container-fluid">
    <h1 class="mt-4">Data Filtration, Paging, and Sorting</h1>

    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-filter me-1"></i>
            Filter, Sort and Export Data
        </div>
        <div class="card-body">
            <form id="filterForm" method="get" class="mb-4">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="firstNameFilter">First Name:</label>
                            <input type="text" id="firstNameFilter" name="firstNameFilter" class="form-control" value="@ViewData["FirstNameFilter"]" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="categoryFilter">Category:</label>
                            <select id="categoryFilter" name="categoryFilter" class="form-control" asp-items="ViewBag.Categories">
                                <option value="">-- All Categories --</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="createdDateFilter">Created Date:</label>
                            <input type="date" id="createdDateFilter" name="createdDateFilter" class="form-control" value="@ViewData["CreatedDateFilter"]" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="sortField">Sort By:</label>
                            <select id="sortField" name="sortField" class="form-control">
                                <option value="ProductId" selected="@(ViewData["SortField"].ToString() == "ProductId")">ID</option>
                                <option value="FirstName" selected="@(ViewData["SortField"].ToString() == "FirstName")">First Name</option>
                                <option value="LastName" selected="@(ViewData["SortField"].ToString() == "LastName")">Last Name</option>
                                <option value="Email" selected="@(ViewData["SortField"].ToString() == "Email")">Email</option>
                                <option value="CreatedDate" selected="@(ViewData["SortField"].ToString() == "CreatedDate")">Created Date</option>
                                <option value="CategoryName" selected="@(ViewData["SortField"].ToString() == "CategoryName")">Category</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="sortDirection">Sort Direction:</label>
                            <select id="sortDirection" name="sortDirection" class="form-control">
                                <option value="ASC" selected="@(ViewData["SortDirection"].ToString() == "ASC")">Ascending</option>
                                <option value="DESC" selected="@(ViewData["SortDirection"].ToString() == "DESC")">Descending</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="pageSize">Page Size:</label>
                            <select id="pageSize" name="pageSize" class="form-control">
                                <option value="5" selected="@(ViewData["PageSize"].ToString() == "5")">5</option>
                                <option value="10" selected="@(ViewData["PageSize"].ToString() == "10")">10</option>
                                <option value="20" selected="@(ViewData["PageSize"].ToString() == "20")">20</option>
                                <option value="50" selected="@(ViewData["PageSize"].ToString() == "50")">50</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-primary">Apply Filters</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Reset</a>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="btn-group" role="group">
                            <a href="@Url.Action("ExportXml", new { firstNameFilter = ViewData["FirstNameFilter"], categoryFilter = ViewData["CategoryFilter"], createdDateFilter = ViewData["CreatedDateFilter"] })" class="btn btn-success me-2">Export to XML</a>
                            <a href="@Url.Action("ExportJson", new { firstNameFilter = ViewData["FirstNameFilter"], categoryFilter = ViewData["CategoryFilter"], createdDateFilter = ViewData["CreatedDateFilter"] })" class="btn btn-info me-2">Export to JSON</a>
                            <a href="@Url.Action("Import")" class="btn btn-warning">Import Data</a>
                        </div>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Category</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ProductId</td>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@(item.CategoryId.HasValue ? $"{item.Category?.Name}" : "None")</td>
                                <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @{
                                int pageNumber = Convert.ToInt32(ViewData["PageNumber"]);
                                int totalPages = Convert.ToInt32(ViewData["TotalPages"]);
                                int pageSize = Convert.ToInt32(ViewData["PageSize"]);

                                if (pageNumber > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { firstNameFilter = ViewData["FirstNameFilter"], categoryFilter = ViewData["CategoryFilter"], createdDateFilter = ViewData["CreatedDateFilter"], sortField = ViewData["SortField"], sortDirection = ViewData["SortDirection"], pageNumber = pageNumber - 1, pageSize = pageSize })">Previous</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#">Previous</a>
                                    </li>
                                }

                                for (int i = Math.Max(1, pageNumber - 2); i <= Math.Min(totalPages, pageNumber + 2); i++)
                                {
                                    <li class="page-item @(i == pageNumber ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { firstNameFilter = ViewData["FirstNameFilter"], categoryFilter = ViewData["CategoryFilter"], createdDateFilter = ViewData["CreatedDateFilter"], sortField = ViewData["SortField"], sortDirection = ViewData["SortDirection"], pageNumber = i, pageSize = pageSize })">@i</a>
                                    </li>
                                }

                                if (pageNumber < totalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Url.Action("Index", new { firstNameFilter = ViewData["FirstNameFilter"], categoryFilter = ViewData["CategoryFilter"], createdDateFilter = ViewData["CreatedDateFilter"], sortField = ViewData["SortField"], sortDirection = ViewData["SortDirection"], pageNumber = pageNumber + 1, pageSize = pageSize })">Next</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#">Next</a>
                                    </li>
                                }
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Handle filter changes
            $('#filterForm select, #filterForm input[type="date"]').on('change', function () {
                $('#filterForm').submit();
            });
        });
    </script>
} 